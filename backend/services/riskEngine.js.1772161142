const axios = require('axios');

async function analyzeWebsiteSecurity(domain) {
  try {
    const url = `https://${domain}`;
    const results = {
      score: 100,
      checks: [],
      details: {
        headers: {},
        ssl: null,
        vulnerabilities: []
      }
    };

    // Fetch website with security headers
    let response;
    try {
      response = await axios.get(url, {
        timeout: 10000,
        maxRedirects: 5,
        validateStatus: () => true,
        headers: {
          'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
        }
      });
      results.details.headers = response.headers;
    } catch (error) {
      results.checks.push({
        name: 'Website Accessibility',
        status: 'fail',
        severity: 'high',
        score: -15,
        message: `Không thể truy cập website: ${error.message}`
      });
      results.score -= 15;
      return calculateFinalScore(results);
    }

    // 1. HTTPS Check
    if (!url.startsWith('https://')) {
      results.checks.push({
        name: 'HTTPS',
        status: 'fail',
        severity: 'high',
        score: -20,
        message: 'Website không sử dụng HTTPS'
      });
      results.score -= 20;
    } else {
      results.checks.push({
        name: 'HTTPS',
        status: 'pass',
        severity: 'info',
        score: 0,
        message: 'Website sử dụng HTTPS'
      });
    }

    // 2. HTTP Strict Transport Security (HSTS)
    const hsts = response.headers['strict-transport-security'];
    if (!hsts) {
      results.checks.push({
        name: 'HSTS',
        status: 'fail',
        severity: 'medium',
        score: -10,
        message: 'Thiếu header Strict-Transport-Security (HSTS)'
      });
      results.score -= 10;
    } else {
      results.checks.push({
        name: 'HSTS',
        status: 'pass',
        severity: 'info',
        score: 0,
        message: `HSTS được cấu hình: ${hsts}`
      });
    }

    // 3. X-Frame-Options (Clickjacking Protection)
    const xFrameOptions = response.headers['x-frame-options'];
    if (!xFrameOptions) {
      results.checks.push({
        name: 'X-Frame-Options',
        status: 'fail',
        severity: 'medium',
        score: -8,
        message: 'Thiếu header X-Frame-Options - dễ bị tấn công Clickjacking'
      });
      results.score -= 8;
    } else {
      results.checks.push({
        name: 'X-Frame-Options',
        status: 'pass',
        severity: 'info',
        score: 0,
        message: `Bảo vệ Clickjacking: ${xFrameOptions}`
      });
    }

    // 4. X-Content-Type-Options
    const xContentType = response.headers['x-content-type-options'];
    if (!xContentType || xContentType.toLowerCase() !== 'nosniff') {
      results.checks.push({
        name: 'X-Content-Type-Options',
        status: 'fail',
        severity: 'low',
        score: -5,
        message: 'Thiếu header X-Content-Type-Options: nosniff'
      });
      results.score -= 5;
    } else {
      results.checks.push({
        name: 'X-Content-Type-Options',
        status: 'pass',
        severity: 'info',
        score: 0,
        message: 'MIME type sniffing được vô hiệu hóa'
      });
    }

    // 5. X-XSS-Protection
    const xssProtection = response.headers['x-xss-protection'];
    if (!xssProtection || !xssProtection.includes('1')) {
      results.checks.push({
        name: 'X-XSS-Protection',
        status: 'warning',
        severity: 'low',
        score: -3,
        message: 'Thiếu hoặc chưa bật X-XSS-Protection'
      });
      results.score -= 3;
    } else {
      results.checks.push({
        name: 'X-XSS-Protection',
        status: 'pass',
        severity: 'info',
        score: 0,
        message: 'XSS Protection được kích hoạt'
      });
    }

    // 6. Content-Security-Policy (CSP)
    const csp = response.headers['content-security-policy'];
    if (!csp) {
      results.checks.push({
        name: 'Content-Security-Policy',
        status: 'fail',
        severity: 'high',
        score: -12,
        message: 'Thiếu Content-Security-Policy - website dễ bị XSS'
      });
      results.score -= 12;
    } else {
      results.checks.push({
        name: 'Content-Security-Policy',
        status: 'pass',
        severity: 'info',
        score: 0,
        message: 'CSP được cấu hình'
      });
    }

    // 7. Referrer-Policy
    const referrerPolicy = response.headers['referrer-policy'];
    if (!referrerPolicy) {
      results.checks.push({
        name: 'Referrer-Policy',
        status: 'warning',
        severity: 'low',
        score: -3,
        message: 'Thiếu Referrer-Policy header'
      });
      results.score -= 3;
    } else {
      results.checks.push({
        name: 'Referrer-Policy',
        status: 'pass',
        severity: 'info',
        score: 0,
        message: `Referrer Policy: ${referrerPolicy}`
      });
    }

    // 8. Permissions-Policy / Feature-Policy
    const permissionsPolicy = response.headers['permissions-policy'] || response.headers['feature-policy'];
    if (!permissionsPolicy) {
      results.checks.push({
        name: 'Permissions-Policy',
        status: 'warning',
        severity: 'low',
        score: -3,
        message: 'Thiếu Permissions-Policy header'
      });
      results.score -= 3;
    } else {
      results.checks.push({
        name: 'Permissions-Policy',
        status: 'pass',
        severity: 'info',
        score: 0,
        message: 'Permissions Policy được cấu hình'
      });
    }

    // 9. Server Header Disclosure
    const serverHeader = response.headers['server'];
    if (serverHeader && (serverHeader.includes('/') || /\d+\.\d+/.test(serverHeader))) {
      results.checks.push({
        name: 'Server Header',
        status: 'warning',
        severity: 'low',
        score: -3,
        message: `Server header tiết lộ thông tin phiên bản: ${serverHeader}`
      });
      results.score -= 3;
      results.details.vulnerabilities.push(`Server version disclosure: ${serverHeader}`);
    } else {
      results.checks.push({
        name: 'Server Header',
        status: 'pass',
        severity: 'info',
        score: 0,
        message: 'Server header không tiết lộ thông tin nhạy cảm'
      });
    }

    // 10. X-Powered-By Header
    const poweredBy = response.headers['x-powered-by'];
    if (poweredBy) {
      results.checks.push({
        name: 'X-Powered-By',
        status: 'warning',
        severity: 'low',
        score: -3,
        message: `Header X-Powered-By tiết lộ công nghệ: ${poweredBy}`
      });
      results.score -= 3;
      results.details.vulnerabilities.push(`Technology disclosure: ${poweredBy}`);
    } else {
      results.checks.push({
        name: 'X-Powered-By',
        status: 'pass',
        severity: 'info',
        score: 0,
        message: 'Không có header X-Powered-By'
      });
    }

    // 11. Cookie Security
    const setCookie = response.headers['set-cookie'];
    if (setCookie) {
      const cookies = Array.isArray(setCookie) ? setCookie : [setCookie];
      let insecureCookies = 0;
      
      cookies.forEach(cookie => {
        const cookieLower = cookie.toLowerCase();
        if (!cookieLower.includes('secure')) {
          insecureCookies++;
        }
        if (!cookieLower.includes('httponly')) {
          insecureCookies++;
        }
      });

      if (insecureCookies > 0) {
        results.checks.push({
          name: 'Cookie Security',
          status: 'fail',
          severity: 'medium',
          score: -8,
          message: `${insecureCookies} cookie(s) thiếu flag Secure hoặc HttpOnly`
        });
        results.score -= 8;
      } else {
        results.checks.push({
          name: 'Cookie Security',
          status: 'pass',
          severity: 'info',
          score: 0,
          message: 'Tất cả cookies có flag Secure và HttpOnly'
        });
      }
    }

    // 12. Mixed Content Check (if HTTPS)
    if (url.startsWith('https://')) {
      const html = typeof response.data === 'string' ? response.data : '';
      const httpResources = html.match(/http:\/\/[^"'\s<>]+/gi) || [];
      
      if (httpResources.length > 0) {
        results.checks.push({
          name: 'Mixed Content',
          status: 'fail',
          severity: 'high',
          score: -10,
          message: `Phát hiện ${httpResources.length} tài nguyên HTTP không bảo mật trong trang HTTPS`
        });
        results.score -= 10;
        results.details.vulnerabilities.push(`Mixed content: ${httpResources.length} HTTP resources`);
      } else {
        results.checks.push({
          name: 'Mixed Content',
          status: 'pass',
          severity: 'info',
          score: 0,
          message: 'Không có mixed content'
        });
      }
    }

    return calculateFinalScore(results);

  } catch (error) {
    return {
      score: 0,
      level: 'critical',
      checks: [{
        name: 'Security Analysis',
        status: 'error',
        severity: 'high',
        score: -100,
        message: `Lỗi phân tích bảo mật: ${error.message}`
      }],
      details: {}
    };
  }
}

function calculateFinalScore(results) {
  // Ensure score is between 0 and 100
  results.score = Math.max(0, Math.min(100, results.score));

  // Determine security level
  if (results.score >= 90) {
    results.level = 'good';
    results.summary = 'Website có cấu hình bảo mật tốt';
  } else if (results.score >= 70) {
    results.level = 'medium';
    results.summary = 'Website có một số vấn đề bảo mật cần khắc phục';
  } else if (results.score >= 50) {
    results.level = 'poor';
    results.summary = 'Website có nhiều vấn đề bảo mật cần được xử lý';
  } else {
    results.level = 'critical';
    results.summary = 'Website có cấu hình bảo mật kém, cần khắc phục ngay';
  }

  return results;
}

module.exports = { analyzeWebsiteSecurity };

