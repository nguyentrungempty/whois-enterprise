const whois = require('whois');

// WHOIS servers for specific TLDs
const WHOIS_SERVERS = {
    'vn': 'whois.vnnic.vn',
    'com.vn': 'whois.vnnic.vn',
    'net.vn': 'whois.vnnic.vn',
    'org.vn': 'whois.vnnic.vn',
    'edu.vn': 'whois.vnnic.vn',
    'gov.vn': 'whois.vnnic.vn',
    'cn': 'whois.cnnic.cn',
    'jp': 'whois.jprs.jp',
    'kr': 'whois.kr',
    'tw': 'whois.twnic.net.tw',
    'hk': 'whois.hkirc.hk',
    'sg': 'whois.sgnic.sg',
    'th': 'whois.thnic.co.th',
    'my': 'whois.mynic.my',
    'id': 'whois.id',
    'ph': 'whois.dot.ph'
};

async function getWhoisInfo(domain) {
    try {
        // Get TLD
        const parts = domain.toLowerCase().split('.');
        let tld = parts[parts.length - 1];

        // Check for second-level domain (e.g., com.vn)
        if (parts.length > 2) {
            const secondLevel = `${parts[parts.length - 2]}.${parts[parts.length - 1]}`;
            if (WHOIS_SERVERS[secondLevel]) {
                tld = secondLevel;
            }
        }

        // Get appropriate WHOIS server
        const server = WHOIS_SERVERS[tld];

        return new Promise((resolve, reject) => {
            const options = {
                timeout: 10000,
                follow: 2
            };

            // Add server if we have a specific one
            if (server) {
                options.server = server;
            }

            whois.lookup(domain, options, (err, data) => {
                if (err) {
                    // If error, try to provide helpful information
                    const errorMsg = err.message || err.toString();

                    if (errorMsg.includes('no whois server') || errorMsg.includes('ENOTFOUND')) {
                        resolve({
                            error: `WHOIS server không khả dụng cho tên miền .${tld}`,
                            message: `Tên miền ${domain} không thể truy vấn WHOIS tự động. Vui lòng truy cập trực tiếp: ${getWhoisWebsite(tld)}`,
                            manualCheck: getWhoisWebsite(tld),
                            tld: tld,
                            domain: domain
                        });
                    } else if (errorMsg.includes('timeout') || errorMsg.includes('ETIMEDOUT')) {
                        resolve({
                            error: 'WHOIS server không phản hồi (timeout)',
                            message: `Không thể kết nối đến WHOIS server cho .${tld}. Vui lòng thử lại sau hoặc truy cập: ${getWhoisWebsite(tld)}`,
                            manualCheck: getWhoisWebsite(tld),
                            tld: tld,
                            domain: domain
                        });
                    } else {
                        resolve({
                            error: 'Lỗi truy vấn WHOIS',
                            message: errorMsg,
                            manualCheck: getWhoisWebsite(tld),
                            tld: tld,
                            domain: domain
                        });
                    }
                    return;
                }

                if (!data || data.trim().length === 0) {
                    resolve({
                        error: 'Không có dữ liệu WHOIS',
                        message: `WHOIS server không trả về dữ liệu cho ${domain}`,
                        manualCheck: getWhoisWebsite(tld),
                        tld: tld,
                        domain: domain
                    });
                    return;
                }

                const parsed = parseWhoisData(data);
                parsed.domain = domain;
                parsed.tld = tld;

                // If no useful data was parsed, return error
                if (!parsed.registrar && !parsed.creationDate && !parsed.nameServers.length) {
                    resolve({
                        error: 'Không thể parse dữ liệu WHOIS',
                        message: 'WHOIS data không đủ thông tin hoặc format không được hỗ trợ',
                        raw: data,
                        manualCheck: getWhoisWebsite(tld),
                        tld: tld,
                        domain: domain
                    });
                    return;
                }

                resolve(parsed);
            });
        });
    } catch (error) {
        return {
            error: 'Exception khi truy vấn WHOIS',
            message: error.message,
            domain: domain
        };
    }
}

function getWhoisWebsite(tld) {
    const websites = {
        'vn': 'https://www.vnnic.vn/whois-information',
        'com.vn': 'https://www.vnnic.vn/whois-information',
        'cn': 'https://whois.cnnic.cn/',
        'jp': 'https://whois.jprs.jp/',
        'kr': 'https://whois.kr/',
        'tw': 'https://www.twnic.net.tw/',
        'hk': 'https://www.hkirc.hk/whois/',
        'default': 'https://www.whois.com/whois/'
    };

    return websites[tld] || websites['default'] + tld;
}

function parseDate(dateString) {
    if (!dateString) return null;

    // Try to parse the date
    const date = new Date(dateString);
    if (isNaN(date.getTime())) return null;

    return date;
}

function formatDate(dateString) {
    if (!dateString) return null;

    const date = parseDate(dateString);
    if (!date) return dateString; // Return original if can't parse

    const day = String(date.getDate()).padStart(2, '0');
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const year = date.getFullYear();

    return `${day}/${month}/${year}`;
}

function calculateDaysRemaining(dateString) {
    if (!dateString) return null;

    const date = parseDate(dateString);
    if (!date) return null;

    const now = new Date();
    const diffTime = date.getTime() - now.getTime();
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

    return diffDays;
}

function parseWhoisData(data) {
    const lines = data.split('\n');
    const result = {
        raw: data,
        registrar: null,
        registrarUrl: null,
        creationDate: null,
        creationDateFormatted: null,
        expirationDate: null,
        expirationDateFormatted: null,
        expirationDaysRemaining: null,
        updatedDate: null,
        updatedDateFormatted: null,
        status: [],
        nameServers: [],
        dnssec: null,
        registrantOrg: null,
        registrantCountry: null,
        adminEmail: null,
        techEmail: null
    };

    lines.forEach(line => {
        const lower = line.toLowerCase();
        const trimmedLine = line.trim();

        // Skip empty lines and comments
        if (!trimmedLine || trimmedLine.startsWith('%') || trimmedLine.startsWith('#')) {
            return;
        }

        // Registrar - Multiple formats
        if ((lower.includes('registrar:') || lower.includes('sponsoring registrar:') || lower.includes('registrar name:')) && !result.registrar) {
            result.registrar = line.split(':').slice(1).join(':').trim();
        }

        // Registrar URL
        if ((lower.includes('registrar url:') || lower.includes('registrar website:')) && !result.registrarUrl) {
            result.registrarUrl = line.split(':').slice(1).join(':').trim();
        }

        // Creation Date - Multiple formats
        if ((lower.includes('creation date:') || lower.includes('created:') || lower.includes('created on:') ||
                lower.includes('registered on:') || lower.includes('registered date:') ||
                lower.includes('domain create date:')) && !result.creationDate) {
            result.creationDate = line.split(':').slice(1).join(':').trim();
        }

        // Expiration Date - Multiple formats
        if ((lower.includes('expir') && lower.includes('date:')) || lower.includes('registry expiry date:') ||
            lower.includes('paid-till:') || lower.includes('expiration date:') ||
            lower.includes('expire date:')) {
            if (!result.expirationDate) {
                result.expirationDate = line.split(':').slice(1).join(':').trim();
            }
        }

        // Updated Date - Multiple formats
        if ((lower.includes('updated date:') || lower.includes('last updated:') || lower.includes('modified:') ||
                lower.includes('changed:') || lower.includes('last modified:')) && !result.updatedDate) {
            result.updatedDate = line.split(':').slice(1).join(':').trim();
        }

        // Status - Multiple formats
        if (lower.includes('domain status:') || (lower.includes('status:') && !lower.includes('dnssec') && !lower.includes('registration'))) {
            const status = line.split(':').slice(1).join(':').trim();
            if (status && !result.status.includes(status) && status.length < 100) {
                result.status.push(status);
            }
        }

        // Name Servers - Multiple formats
        if (lower.includes('name server:') || lower.includes('nserver:') || lower.includes('nameserver:') ||
            lower.includes('dns:') || lower.match(/^ns\d*:/)) {
            const ns = line.split(':').slice(1).join(':').trim().split(/\s+/)[0]; // Get first part (domain only)
            if (ns && !result.nameServers.includes(ns) && ns.includes('.') && !ns.includes('@')) {
                result.nameServers.push(ns.toLowerCase());
            }
        }

        // DNSSEC
        if (lower.includes('dnssec:') && !result.dnssec) {
            result.dnssec = line.split(':').slice(1).join(':').trim();
        }

        // Registrant Organization - Multiple formats
        if ((lower.includes('registrant organization:') || lower.includes('registrant:') ||
                lower.includes('org:') || lower.includes('organisation:')) && !result.registrantOrg) {
            const org = line.split(':').slice(1).join(':').trim();
            if (org && org.toLowerCase() !== 'redacted for privacy' && org.toLowerCase() !== 'data redacted') {
                result.registrantOrg = org;
            }
        }

        // Registrant Country
        if ((lower.includes('registrant country:') || lower.includes('country:')) && !result.registrantCountry) {
            result.registrantCountry = line.split(':').slice(1).join(':').trim();
        }

        // Admin Email
        if (lower.includes('admin email:') && !result.adminEmail) {
            const email = line.split(':').slice(1).join(':').trim();
            if (email && !email.toLowerCase().includes('redacted')) {
                result.adminEmail = email;
            }
        }

        // Tech Email
        if (lower.includes('tech email:') && !result.techEmail) {
            const email = line.split(':').slice(1).join(':').trim();
            if (email && !email.toLowerCase().includes('redacted')) {
                result.techEmail = email;
            }
        }
    });

    // Format dates
    if (result.creationDate) {
        result.creationDateFormatted = formatDate(result.creationDate);
    }

    if (result.expirationDate) {
        result.expirationDateFormatted = formatDate(result.expirationDate);
        result.expirationDaysRemaining = calculateDaysRemaining(result.expirationDate);
    }

    if (result.updatedDate) {
        result.updatedDateFormatted = formatDate(result.updatedDate);
    }

    // Clean up data
    if (result.registrar && result.registrar.toLowerCase().includes('redacted')) {
        result.registrar = 'Privacy Protected';
    }

    // Remove duplicates from arrays
    result.status = [...new Set(result.status)];
    result.nameServers = [...new Set(result.nameServers)];

    return result;
}

module.exports = { getWhoisInfo };
